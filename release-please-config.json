{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "bump-minor-pre-major": true,
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == 'cbc' || @.name.value == 'chatbotchat-client' || @.name.value == 'chatbotchat-core' || @.name.value == 'chatbotchat-protocol' || @.name.value == 'chatbotchat-server')].version"
        }
      ]
    }
  }
}
